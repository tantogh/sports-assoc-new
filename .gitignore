# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated at build time (scripts/generate-sitemap.mjs, scripts/generate-robots.mjs)
/public/sitemap.xml
/public/robots.txt

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env は公開ビルド設定（SITE_URL）のみなのでコミットする
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
